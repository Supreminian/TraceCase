      "required_checks": [
        {
          "id": "C01",
          "condition": "同一申请人已有待审批发票 INV-A，再提交 INV-A",
          "expected": "拒绝新提交"
        },
        {
          "id": "C02",
          "condition": "同一申请人已有已审批发票 INV-A，再提交 INV-A",
