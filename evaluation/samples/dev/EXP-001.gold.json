{
  "schema_version": "1.0",
  "sample_id": "EXP-001",
  "paragraphs": [
    {
      "id": "P001",
      "text": "# 完整单据审批"
    },
    {
      "id": "P002",
      "text": "这是虚构的费用报销系统。申请人提交自己的报销单，一级审批人和二级审批人分别执行对应级别的审批。金额单位为元，仅允许正整数。"
    },
    {
      "id": "P003",
      "text": "所有报销单先由一级审批人处理。金额不超过 5,000 元，一级通过后状态为已审批；金额大于 5,000 元，一级通过后交给二级审批人，二级通过后状态为已审批。"
    },
    {
      "id": "P004",
      "text": "已审批单的金额禁止直接修改；系统保持原金额与已审批状态。"
    },
    {
      "id": "P005",
      "text": "任一审批人驳回时必须填写原因；未填写原因则驳回不生效，填写非空文本原因则单据状态变为已驳回。"
    }
  ],
  "key_rules": [
    {
      "id": "R01",
      "paragraph_ids": [
        "P002"
      ],
      "statement": "只允许正整数金额",
      "executable": true,
      "required_checks": [
        {
          "id": "C01",
          "condition": "申请人提交金额 0 的新单",
          "expected": "拒绝提交"
        },
        {
          "id": "C02",
          "condition": "提交金额 1 的新单",
          "expected": "金额校验通过"
        },
        {
          "id": "C03",
          "condition": "提交金额 -1 的新单",
          "expected": "拒绝提交"
        },
        {
          "id": "C04",
          "condition": "提交金额 1.5 的新单",
          "expected": "拒绝提交"
        }
      ]
    },
    {
      "id": "R02",
      "paragraph_ids": [
        "P003"
      ],
      "statement": "按 5,000 元阈值路由",
      "executable": true,
      "required_checks": [
        {
          "id": "C01",
          "condition": "金额 5,000 的单据一级通过",
          "expected": "状态为已审批"
        },
        {
          "id": "C02",
          "condition": "金额 5,001 的单据一级通过",
          "expected": "进入二级审批"
        },
        {
          "id": "C03",
          "condition": "金额 5,001 的单据二级通过",
          "expected": "状态为已审批"
        }
      ]
    },
    {
      "id": "R03",
      "paragraph_ids": [
        "P004"
      ],
      "statement": "锁定已审批金额",
      "executable": true,
      "required_checks": [
        {
          "id": "C01",
          "condition": "修改已审批单金额",
          "expected": "拒绝并保留金额、状态"
        }
      ]
    },
    {
      "id": "R04",
      "paragraph_ids": [
        "P005"
      ],
      "statement": "驳回原因必填",
      "executable": true,
      "required_checks": [
        {
          "id": "C01",
          "condition": "未填写原因发起驳回",
          "expected": "不生效"
        },
        {
          "id": "C02",
          "condition": "填写非空文本原因驳回",
          "expected": "状态已驳回"
        }
      ]
    }
  ],
  "clarifications": [],
  "prohibited_inferences": [
    "原因最小字数",
    "撤回或冲正流程"
  ]
}
