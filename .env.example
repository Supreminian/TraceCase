# Optional SQLite location. The application reads environment variables; it does not load .env files.
SDLC_DB_PATH=data/sdlc.sqlite3
# Default service provider: google; use compatible for an explicit compatible endpoint.
SDLC_MODEL_PROVIDER=google
# For compatible provider. URL is the COMPLETE Chat Completions endpoint.
# HTTPS required remotely; HTTP permitted only for localhost / loopback.
SDLC_MODEL_URL=
SDLC_MODEL_NAME=
SDLC_MODEL_API_KEY=
SDLC_MODEL_TIMEOUT=180
SDLC_MODEL_MAX_TOKENS=32768
# Google Gemini: same default model as the user's desktop-pet project.
# Alternatively scripts/run_google.py reads the existing macOS Keychain into process memory.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Authenticated local gateway and private Streamlit service (loopback only).
SDLC_GATEWAY_PORT=8501
SDLC_PRIVATE_PORT=8502
# Set 1 only behind correctly configured HTTPS termination.
SDLC_COOKIE_SECURE=0

# Optional GitHub OAuth login. All three are required; never commit the real secret.
# Create a dedicated OAuth App and register the exact callback URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8501/auth/github/callback

# Agent native protocols: google / openai / anthropic. No provider or paid fallback.
SDLC_AGENT_PROVIDER=google
SDLC_AGENT_ASSISTANT_MODEL=gemini-3.5-flash-lite
SDLC_AGENT_ASSISTANT_EFFORT=high
# Configure a separate faster/cheaper reviewer model if available in your provider project.
# If omitted, reuse the configured provider default. Price is not inferred by the app.
SDLC_AGENT_REVIEWER_MODEL=gemini-3.5-flash-lite
SDLC_AGENT_REVIEWER_EFFORT=low
# Use effort=default for a model that does not support explicit effort controls.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
SDLC_AGENT_MAX_MODEL_CALLS=64
SDLC_AGENT_MAX_TOTAL_TOKENS=200000
SDLC_AGENT_MAX_TOOL_CALLS=32
SDLC_AGENT_MAX_ITERATIONS=20
SDLC_AGENT_MAX_SECONDS=900
SDLC_AGENT_MODEL_TIMEOUT=120
# Shared pacing across local workers; set from the actual provider project quota.
# This does not account for other applications sharing the same provider project.
SDLC_AGENT_GOOGLE_MIN_INTERVAL=5
# Defaults beside SDLC_DB_PATH; do not expose this private directory via HTTP.
SDLC_AGENT_SESSION_DIR=
# BashTool is implemented for explicitly authorized local diagnostics only.
# It is not registered as a testing Agent capability.
