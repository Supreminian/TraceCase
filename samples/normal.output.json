{
  "schema_version": "1.0",
  "features": [
    {
      "id": "F-001",
      "description": "虚构费用报销提交与审批",
      "paragraph_ids": [
        "P003",
        "P004",
        "P005",
        "P006",
        "P007"
      ]
    }
  ],
  "roles": [
    {
      "id": "ROLE-001",
      "name": "申请人",
      "responsibilities": [
        "提交自己的报销单"
      ],
      "paragraph_ids": [
        "P002"
      ]
    },
    {
      "id": "ROLE-002",
      "name": "一级审批人",
      "responsibilities": [
        "处理待一级审批报销单"
      ],
      "paragraph_ids": [
        "P002"
      ]
    },
    {
      "id": "ROLE-003",
      "name": "二级审批人",
      "responsibilities": [
        "处理待二级审批报销单"
      ],
      "paragraph_ids": [
        "P002"
      ]
    }
  ],
  "business_rules": [
    {
      "id": "R-001",
      "statement": "申请人提交自己的报销单，填写金额及发票号后提交成功，状态为待一级审批。",
      "status": "clear",
      "paragraph_ids": [
        "P002",
        "P003"
      ]
    },
    {
      "id": "R-002",
      "statement": "所有报销单经一级审批；不超过5000元一级通过即已审批；大于5000元一级通过后待二级，二级通过才已审批。",
      "status": "clear",
      "paragraph_ids": [
        "P002",
        "P004"
      ]
    },
    {
      "id": "R-003",
      "statement": "已审批单不允许申请人直接修改金额，原金额保持不变。",
      "status": "clear",
      "paragraph_ids": [
        "P002",
        "P005"
      ]
    },
    {
      "id": "R-004",
      "statement": "相应审批人驳回待处理单必须提供非空且不全为空白的原因；缺少则状态不变，提供则已驳回并保存原因。",
      "status": "clear",
      "paragraph_ids": [
        "P002",
        "P006"
      ]
    },
    {
      "id": "R-005",
      "statement": "所有申请人间，完全相同发票号不得重复成功提交；四种成功提交状态参与去重，失败提交不参与。",
      "status": "clear",
      "paragraph_ids": [
        "P007"
      ]
    }
  ],
  "clarifications": [],
